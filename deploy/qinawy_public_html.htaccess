Options -MultiViews

<IfModule mod_headers.c>
  # HSTS on EVERY response — including 301 redirects. After one HTTPS visit
  # the browser stops attempting http:// or www. on its own. (Googlebot
  # ignores HSTS but real users get a faster experience.)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
  <FilesMatch "\.(css|svg|png|jpg|jpeg|webp|gif|ico|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

RewriteEngine On

# Canonicalize host + scheme in a single hop:
#   http://qinawy.com/x       → https://qinawy.com/x
#   http://www.qinawy.com/x   → https://qinawy.com/x   (was 2 hops)
#   https://www.qinawy.com/x  → https://qinawy.com/x
# The TLS cert covers both hosts. The E=REDIR:1 flag tags the response so
# the Header directives below can add long-lived caching — telling Googlebot
# and other crawlers "this redirect is permanent, don't keep re-checking it".
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.qinawy\.com$ [NC]
RewriteRule ^(.*)$ https://qinawy.com/$1 [R=301,L,E=REDIR:1]

<IfModule mod_headers.c>
  # Aggressive caching for 301 redirects. The redirect target never changes,
  # so a 1-year max-age tells crawlers (Google included) to stop re-validating
  # these URLs as "Page with redirect" findings. They become silent once
  # cached and eventually fall off GSC's active reports.
  Header always set Cache-Control "public, max-age=31536000, immutable" env=REDIR
</IfModule>

# Hostinger's internal build folder — never expose it
RewriteRule ^\.builds - [F,L]

# SEO: dynamic sitemap.xml at the domain root, backed by the Node backend.
RewriteRule ^sitemap\.xml$ /api/sitemap.xml [L]

# Static files (assets, ads.txt, robots.txt, favicons) — serve as-is.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# /api/* requests are handled by public_html/api/.htaccess with its own
# Passenger directives. Pass through so those rules apply.
RewriteRule ^api($|/) - [L]

# Everything else → Passenger with SPA catch-all. The backend's spaCatchAll
# middleware serves per-route SSR'd HTML for /, /about, /category/*, /service/*
PassengerAppRoot /home/u492425110/domains/qinawy.com/nodejs
PassengerAppType node
PassengerNodejs /opt/alt/alt-nodejs22/root/bin/node
PassengerStartupFile src/index.js
PassengerBaseURI /
PassengerRestartDir /home/u492425110/domains/qinawy.com/nodejs/tmp
SetEnv NODE_ENV=production
